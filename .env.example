# ClearPath Content — local-only secrets. Copy to .env and fill in.
# .env is gitignored. Never commit real values.
#
# Google Places API (New) — required by scripts/prospect-source.mjs.
# The sourcing sweep runs on your machine, not in a function, so this key
# belongs in your shell and NOT in Netlify's environment variables.
GOOGLE_PLACES_API_KEY=

# Only needed for `--push`, which sends a completed sweep to the live
# prospect store. Same value as CPC_ADMIN_TOKEN in Netlify.
CPC_ADMIN_TOKEN=
